# ==========================================
# BASE DE DATOS - POSTGRESQL
# ==========================================
POSTGRES_USER=abasto
POSTGRES_PASSWORD=cambiar_esto
POSTGRES_DB=abasto

# ==========================================
# CORS - FRONTEND
# ==========================================
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ==========================================
# JWT - AUTENTICACIÓN
# ==========================================

Jwt__Key=REEMPLAZAR_POR_LA_CLAVE
Jwt__Issuer=abasto-api
Jwt__Audience=abasto
Jwt__AccessTokenMinutos=15
Jwt__RefreshTokenDias=7

# ==========================================
# ADMINISTRADOR INICIAL
# ==========================================

Admin__Correo=admin@abasto.cu
Admin__Contrasena=REEMPLAZAR_POR_LA_CONTRASEÑA
Admin__Nombres=Administrador
Admin__Apellidos=del sistema